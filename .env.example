TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-a-database-token
# Optional local alternative: proxy API requests through the deployed app so localhost uses its Turso ledger.
ZPP_UPSTREAM_URL=https://your-vercel-project.vercel.app
ZPP_SESSION_SECRET=replace-with-a-long-random-secret
ZPP_ADMIN_PASSWORD=replace-before-the-first-start
ZPP_STAFF_PASSWORD=replace-before-the-first-start
